            Fendji, Jean Louis Ebongue Kedieng and
            Jojo, Masixole and
            Kamara, Lukeman Sahid and
            Kallon, Lansana Hassim and
            Kargbo, Adam and
            Kitio, Linuce Demanou and
            Likassa, Habte Tadesse and
            Lalléchère, Sébastien and
            Makoni, Pedzisai Anotida and
            Mokhele, Shoeshoe and
            Mosima, Lerato Sarah and
            Odume, Oghenekaro Nelson and
            Ravelo, Blaise and
            Nnadozie, Chika Felicitas and
            Sandjo, Louis Pergaud and
            Saidu, Samuel and
            Sibiya, Ntethelelo and
            Soares, Bruno Gabriel Larsen and
            Tenkam, Herve Michel and
            Witika, Bwalya Angel and
            Zaza, Siphendulwe and
            Siwe Noundou, Xavier},
  year = {2026},
  note = {Submitted to npj Digital Medicine},
  abbr = {Under review},
  abstract = {Neglected tropical diseases (NTDs) affect over one billion people globally and disproportionately impact low-resource tropical and subtropical regions. While artificial intelligence (AI) offers significant opportunities to strengthen NTD control, the scope, maturity, and translational readiness of existing applications remain unclear. We conducted a systematic review of AI methods applied to NTD-related problems using Scopus and Web of Science, following PRISMA guidelines. Across 289 studies, AI applications were primarily concentrated in diagnosis, surveillance, and prognosis, with most relying on supervised learning from imaging, clinical, or epidemiological data. However, external validation, calibration, and prospective evaluation were limited, and research was geographically concentrated in a small number of countries. Overall, despite rapid growth in the field, substantial gaps remain in methodological rigor, equity, and real-world deployment readiness, highlighting the need for more robust, transparent, and context-aware AI research in NTDs.},
  bibtex_show = {true}
}

@unpublished{brima2026benchmark,
  title = {From Benchmark to Bedside: A Roadmap for Trustworthy Artificial Intelligence Across African Healthcare Contexts},
  author = {Brima, Yusuf and
            Atemkeng, Marcellin and
            Oyetunji, Nicole and
            Nhlapho, Wandile and
            Fendji, Jean Louis Ebongue Kedieng},
  year = {2026},
  note = {Proposed long article for the CACM Africa Special Section (Societal Impact: Healthcare)},
  abbr = {Proposed},
  abstract = {Artificial intelligence (AI) is advancing across the healthcare continuum, from early diagnosis and risk stratification to public health surveillance. Across Africa, researchers are applying state-of-the-art AI models to local health data at all scales, from community clinics to tertiary referral hospitals. These efforts show both remarkable promise and a clear caution: strong benchmark scores often fail to transfer to populations and workflows the models were not trained on. This work asks how healthcare AI in Africa can move from promising, isolated pilots to safe, locally governed and sustainable use. We argue that the next step is to connect these use cases to a broader, locally governable ecosystem. African data realities are already testing global models: recent studies in fetal ultrasound across five countries, brain MRI in Nigeria, cervical CT in Zambia, diabetic retinopathy screening in Kenya and dermatology in Uganda reveal downsides of transfer, under-representation, and explanations not always faithful to model behaviour. At the same time, work in tuberculosis screening, ultraportable X-ray, cough-based screening and smartphone ultrasound shows how AI may support services facing severe workforce and infrastructure constraints, while reminding us that accuracy alone does not establish clinical utility. We bring these developments together in a five-stage roadmap for translating healthcare AI: development, evaluation, deployment, scaling and, crucially, sustainment. Across the cycle, we identify three foundations that must move together: responsibly governed, interoperable data aligned with the FAIR principles; African agency over data, models, compute infrastructure and research priorities, including through federated and emerging multimodal approaches; and trust built through locally relevant validation, transparent reporting, regulation and prospective real-world evidence. Fit-for-purpose technology, affordable workflows, interdisciplinary capacity and sustained funding are not afterthoughts but preconditions for lasting impact. This article synthesises examples across countries and programmes, including AFRICAI and AFRICAI-RI, and connects them to the African Union's Data Policy Framework and Continental AI Strategy, WHO guidance, and consensus frameworks such as FUTURE-AI. Rather than treating Africa as one health system or proposing a single model for every setting, we make the case for locally governable AI systems evaluated in tandem with the communities and services expected to use and sustain them. Africa carries a large share of the global disease burden while facing acute shortages of health workers, diagnostic capacity and infrastructure. AI could help extend scarce expertise, but only if tools are validated on local populations, fit real clinical workflows and are governed by African institutions, rather than imported as finished products. Globally, models developed or validated across diverse African contexts can expose blind spots in supposedly general-purpose AI, while a stronger African research ecosystem can contribute to more robust, equitable and clinically useful healthcare AI. Africa's genetic, epidemiological and health-system diversity makes it a demanding testbed for how well AI generalises, with lessons for other low- and middle-income settings and for high-income health systems serving diverse populations.},
  bibtex_show = {true}
}
